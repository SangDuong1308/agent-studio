# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in values. docker-compose reads `.env`.
# ---------------------------------------------------------------------------

# --- Database ---
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agentstudio
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Async SQLAlchemy URL (used by services). For local tooling swap host to localhost.
DATABASE_URL=postgresql+asyncpg://agent:agent@postgres:5432/agentstudio

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM provider: "vertex" (real) or "fake" (tests/local without GCP) ---
LLM_PROVIDER=fake

# --- Vertex AI (only needed when LLM_PROVIDER=vertex) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# "global": Gemini 3.x models aren't served from us-central1.
GOOGLE_CLOUD_LOCATION=global
# Path (inside the container) to a service-account key with Vertex AI User role.
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-key.json
VERTEX_CHAT_MODEL=gemini-3.5-flash-lite
# 768-dim model; the DB column is vector(768). text-embedding-005 retires 2027-04-01.
VERTEX_EMBEDDING_MODEL=text-embedding-005
# Guards for cost and latency.
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# --- Saga ---
SAGA_TIMEOUT_SECONDS=300
# How often the orchestrator looks for stuck sagas.
SAGA_REAPER_INTERVAL_SECONDS=30

# --- Retrieval ---
RETRIEVAL_TOP_K=4
# Cosine distance cutoff (0 = identical). Chunks farther than this are ignored.
RETRIEVAL_MAX_DISTANCE=0.55

# --- Security ---
# "local" or "production". production refuses to start with weak secrets.
APP_ENV=local
# Shared secret for gateway -> agent-runtime calls. Generate: openssl rand -hex 32
INTERNAL_API_KEY=
# Browser origins allowed to call the gateway (comma-separated).
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_QUERY_PER_MINUTE=20
RATE_LIMIT_CREATE_PER_HOUR=10
MAX_AGENTS_PER_USER=20

# --- LangFuse observability (optional; leave blank to disable) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Service URLs (inter-service HTTP where used) ---
AGENT_RUNTIME_URL=http://agent-runtime:8003

# --- Logging ---
LOG_LEVEL=INFO
